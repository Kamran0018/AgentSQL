# Data-Agent AI Environment Variables

# Groq API Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Django Settings
DJANGO_SECRET_KEY=generate-a-secure-random-secret-key-for-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# DataSource Security & Encryption
# Optional: base64-encoded 32-byte Fernet key. If omitted, derived from DJANGO_SECRET_KEY.
DATASOURCE_ENCRYPTION_KEY=
# Set to False in production to prevent SSRF by blocking private/loopback/link-local IP DB connections
ALLOW_PRIVATE_DB_HOSTS=True

# Usage Limits
DAILY_QUESTION_LIMIT=50
